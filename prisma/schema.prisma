// Prisma schema file for Backend Template / Boilerplate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model Users {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  role               Role      @default(USER)
  phoneNumber        String?   @map("phone_number")
  isVerified         Boolean   @default(false) @map("is_verified")
  verifyToken        String?   @map("verify_token")
  verifyTokenExpires DateTime? @map("verify_token_expires")
  lastSendVerify     DateTime? @map("last_send_verify")
  resetToken         String?   @map("reset_token")
  resetTokenExpires  DateTime? @map("reset_token_expires")
  lastSendReset      DateTime? @map("last_send_request")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("users")
}
