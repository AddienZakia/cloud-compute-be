{
  "name": "backend-template",
  "version": "1.0.0",
  "description": "Clean, scalable TypeScript Express & Prisma backend boilerplate template",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "db:gen": "pnpm exec prisma generate",
    "db:push": "pnpm exec prisma db push",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:deploy": "pnpm exec prisma migrate deploy",
    "db:reset": "pnpm exec prisma migrate reset",
    "db:studio": "pnpm exec prisma studio",
    "db:format": "pnpm exec prisma format",
    "db:seed": "tsx prisma/seed/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "boilerplate",
    "starter",
    "template",
    "express",
    "typescript",
    "prisma",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.11",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/winston": "^2.4.4",
    "husky": "^9.1.7",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0"
  }
}
