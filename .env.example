# Application Port & URL
PORT=3000
NODE_ENV=development
BASE_URL="http://localhost:3000"

# PostgreSQL Database (Docker Compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=backend_db
DB_PORT=5432

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backend_db?schema=public"

# JWT & Authentication Secrets
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
TOKEN_SECRET="your-super-secret-token-key-change-in-production"

# Auth Timing Configurations (in minutes)
COOLDOWN_VERIFY=15
COOLDOWN_RESET=10
COOLDOWN_JWT=15

# SMTP / Email Configuration (Nodemailer)
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="your-smtp-user"
EMAIL_PASS="your-smtp-password"
EMAIL_FROM="noreply@example.com"

# Azure Blob Storage Configuration
# Pilihan 1: Pakai Connection String langsung
AZURE_STORAGE_CONNECTION_STRING=""

# Pilihan 2: Pakai Account Name + Account Key
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""

# Container Name
AZURE_STORAGE_CONTAINER_NAME="cloud-items"

# Apache Kafka Configuration (Single Kafka Server)
KAFKA_BROKER="localhost:9092,localhost:29092"
KAFKA_CLIENT_ID="cloud-be"
KAFKA_GROUP_ID="cloud-be-group"
KAFKA_ENABLED="true"
