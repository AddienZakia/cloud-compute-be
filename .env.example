# Application Port & URL
PORT=3000
NODE_ENV=development
BASE_URL="http://localhost:3000"

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backend_db?schema=public"

# JWT & Authentication Secrets
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
TOKEN_SECRET="your-super-secret-token-key-change-in-production"

# Auth Timing Configurations (in minutes)
COOLDOWN_VERIFY=15
COOLDOWN_RESET=10
COOLDOWN_JWT=15

# SMTP / Email Configuration (Nodemailer)
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="your-smtp-user"
EMAIL_PASS="your-smtp-password"
EMAIL_FROM="noreply@example.com"
